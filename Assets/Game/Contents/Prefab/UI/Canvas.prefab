  m_text: "\u042F \u0417\u041D\u0410\u041B, \u0425\u0410\u0425\u0410, \u0417\u041D\u0410\u041B
    \u0427\u0422\u041E \u041E\u041D\u0418 \u041F\u0420\u0418\u0414\u0423\u0422, \u0421\u0422\u0412\u041E\u041B
    \u0412\u0410\u041C, \u0410 \u041D\u0415 \u041C\u041E\u0419 \u0423\u0420\u041E\u0416\u0410\u0419!
    \u041D\u0423\u0416\u041D\u041E \u041D\u0415 \u0414\u0410\u0422\u042C \u0427\u0423\u0411\u0420\u0418\u041A\u041E\u0421\u0410\u041C
