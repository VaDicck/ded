--- !u!114 &6801532744789214951
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5865860198016855346}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 498945c8f6104aa7989171e7f3cbd49a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintsView
  _text: {fileID: 163447366366812095}
  _beds:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  _unlockBeds: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    3 \u0433\u0440\u044F\u0434\u043A\u0438 \u043A\u0438\u0440\u043A\u043E\u0439"
  _plowBeds: "\u041F\u0440\u043E\u043F\u043E\u043B\u043E\u0442\u044C 3 \u0433\u0440\u044F\u0434\u043A\u0438
    \u0433\u0440\u0430\u0431\u043B\u044F\u043C\u0438"
  _cultures: "\u0412\u044B\u0441\u0430\u0434\u0438\u0442\u044C \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F
    \u043D\u0430 3 \u0433\u0440\u044F\u0434\u043A\u0438"
  _water: "\u041F\u043E\u043B\u0438\u0442\u044C 3 \u0433\u0440\u044F\u0434\u043A\u0438"
  _waitNight: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u043D\u043E\u0447\u0438
    (\u043A\u0440\u0435\u0441\u043B\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
    \u0441\u043A\u043E\u0440\u043E\u0442\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F)"
  _protectPlants: "\u0417\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u043E\u0433\u043E\u0440\u043E\u0434
    \u043E\u0442 \u043F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u0435\u0432"
  _goToBed: "\u041B\u0435\u0447\u044C \u0441\u043F\u0430\u0442\u044C \u043D\u0430
    \u043A\u0440\u043E\u0432\u0430\u0442\u044C"
  _getPlants: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0443\u0440\u043E\u0436\u0430\u0439
    \u0441 3-\u0445 \u0433\u0440\u044F\u0434\u043E\u043A"
  _goToQuota: "\u0421\u0434\u0430\u0439\u0442\u0435 \u0443\u0440\u043E\u0436\u0430\u0439
    \u0432 \u043F\u043E\u0434\u044A\u0435\u0445\u0430\u0432\u0448\u0438\u0439 \u043F\u043E\u0435\u0437\u0434"
  _congrats: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C!
    \u041A\u043E\u043D\u0442\u0435\u043D\u0442 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F"
  _cycleThis: "\u041F\u043E\u0432\u0442\u043E\u0440\u044F\u0439\u0442\u0435 \u0438
    \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u043A\u0432\u043E\u0442\u0443
    \u0437\u0430 3 \u0434\u043D\u044F. \u041F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0435\u0441\u044C!"
